# Paperclip origin as seen from the MCP process. Compose's default uses the host gateway.
PAPERCLIP_BASE_URL=http://host.docker.internal:3100
PAPERCLIP_MCP_PORT=8000
PAPERCLIP_MCP_LOG_LEVEL=INFO

# Generate this file with: paperclip-mcp token --output secrets/mcp_token
# Required by the hardened Compose service and used only for inbound MCP authentication.
PAPERCLIP_MCP_TOKEN_FILE=./secrets/mcp_token

# Leave unset when Paperclip runs in local_mode. The authenticated Compose overlay mounts
# this file. Its value must differ from the contents of PAPERCLIP_MCP_TOKEN_FILE.
PAPERCLIP_API_TOKEN_FILE=./secrets/paperclip_api_token
